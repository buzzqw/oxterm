#!/usr/bin/env bash

set -u

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT_DIR" ]]; then
    printf '%s\n' 'terust post-commit: repository root not found' >&2
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    printf '%s\n' 'terust post-commit: cargo not found; build skipped' >&2
    exit 0
fi

printf '%s\n' 'terust post-commit: building release executable...'
if ! cargo build --release --manifest-path "$ROOT_DIR/Cargo.toml" --quiet; then
    printf '%s\n' 'terust post-commit: release build failed' >&2
    exit 0
fi

install -m 0755 "$ROOT_DIR/target/release/terust" "$ROOT_DIR/terust-linux-x86-64"
printf '%s\n' "terust post-commit: created $ROOT_DIR/terust-linux-x86-64"
