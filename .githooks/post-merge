#!/usr/bin/env bash
# post-merge - refresh the build and the installed binary after git pull.

set -u

[[ "${OXTERM_SKIP_HOOKS:-0}" == "1" ]] && exit 0

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "$ROOT_DIR" ]]; then
    printf '%s\n' 'Oxterm post-merge: repository root not found' >&2
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    printf '%s\n' 'Oxterm post-merge: cargo not found; build skipped' >&2
    exit 0
fi

printf '%s\n' 'Oxterm post-merge: building release executable...'
if ! cargo build --release --locked --manifest-path "$ROOT_DIR/Cargo.toml" --quiet; then
    printf '%s\n' 'Oxterm post-merge: release build failed' >&2
    exit 0
fi

BUILT="$ROOT_DIR/target/release/oxterm"
install -m 0755 "$BUILT" "$ROOT_DIR/oxterm-linux-x86-64"

# Refresh the copies `oxterm` in PATH resolves to, so the next launch runs this
# build instead of whichever version was installed last.
"$ROOT_DIR/scripts/refresh-installed.sh"
